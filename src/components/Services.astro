---
const services = [
  { title: "FRONTEND", text: "Fast, polished interfaces people actually enjoy using." },
  { title: "BACKEND", text: "APIs, databases and logic built to hold up under real use." },
  { title: "MOBILE", text: "iOS and Android apps, on the same solid foundation." },
  { title: "DEVOPS", text: "VPS setups and CI/CD pipelines. Releases stay boring. Uptime stays high." },
];
---

<section class="services">
  <div class="wrap stack">
    <div class="row">
      <h2 class="display">WHAT I DO</h2>
      <p class="eyebrow">(02) — SERVICES</p>
    </div>
    <div class="svc-grid">
      {services.map((service, i) => (
        <div class="svc reveal">
          <p class="eyebrow">{String(i + 1).padStart(2, "0")}</p>
          <h3 class="display">{service.title}</h3>
          <p>{service.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
