---
import { yearsOfExperience } from "../data/site";
---

<section id="about" class="about">
  <div class="wrap stack">
    <div class="row">
      <p class="eyebrow">(01) — ABOUT</p>
      <p class="eyebrow">FULL-STACK DEVELOPER · BUTWAL, NEPAL</p>
    </div>
    <h2 class="display h-xl reveal">I BUILD IT.<br /><span>I SHIP IT.</span><br />I RUN IT.</h2>
    <div class="about-body">
      <p class="reveal">I’m Shashank Adhikari, a full-stack developer from Nepal, shipping software since 2018. Interfaces, APIs, databases, VPS, CI/CD: I own the whole journey, so nothing gets lost in a handoff. One developer who cares how it looks, how it works and whether it stays up.</p>
      <div class="tiles reveal">
        <div class="tile t1 lift"><p class="big">{yearsOfExperience}+</p><small>YEARS OF EXPERIENCE</small></div>
        <div class="tile t2 lift"><p class="big">DEV<br />OPS</p><small>BUILD TO DEPLOY</small></div>
        <div class="tile t3 lift"><p class="big">NEPAL</p><small>WORKING WORLDWIDE</small></div>
      </div>
    </div>
  </div>
</section>
