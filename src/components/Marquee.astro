---
const skills = ["REACT", "NEXT.JS", "TYPESCRIPT", "LARAVEL", "APIS", "DATABASES", "CI/CD", "CLOUD", "DEVOPS"];
---

<div class="marquee" role="region" aria-label="Skills: React, Next.js, TypeScript, Laravel, APIs, databases, CI/CD, cloud, DevOps">
  <div class="mq" aria-hidden="true">
    {[...skills, ...skills].map((skill) => <span>{skill} <i>✺</i></span>)}
  </div>
</div>
